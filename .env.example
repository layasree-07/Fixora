# Copy to .env or configure these variables in your shell/deployment platform.
# Never commit real secrets.
DB_URL=jdbc:mysql://localhost:3306/fixora?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
# Optional trusted admin seed; account is created only if both are set and password >=12 chars.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-12-chars-minimum
# Local development only: lets customer retrieve in-memory OTP. Keep false/undefined in production.
OTP_TEST_REVEAL=true
